# Google Sheets ID (스프레드시트 URL에서 복사)
# 예: https://docs.google.com/spreadsheets/d/{이 부분이 SHEET_ID}/edit
GOOGLE_SHEET_ID=

# ── 교사 대시보드 (Supabase) ──
# Supabase 프로젝트 → Settings → API 에서 복사
# 주의: NEXT_PUBLIC_ 접두사를 붙이지 마세요 (브라우저에 노출 금지)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 교사 대시보드(/teacher) 로그인 비밀번호
TEACHER_PASSWORD=
# (선택) 세션 쿠키 서명용 별도 시크릿. 비우면 TEACHER_PASSWORD 사용
TEACHER_SESSION_SECRET=
